<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gemstone_image_proc</name>
  <version>0.1.0</version>
  <description>
    Kameradan gelen goruntu uzerinde islem yapacak node'lar icin iskelet paket.
    Su an icin gelen goruntuyu olceklendirip/gecirerek yayinlayan bir placeholder
    node icerir; serit takibi / nesne tespiti gibi gorevler buraya eklenecek.
  </description>
  <maintainer email="gemstone@todo.todo">gemstone</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
