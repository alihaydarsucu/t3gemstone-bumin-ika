<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gemstone_imu</name>
  <version>0.1.0</version>
  <description>
    T3 Gemstone O1 karti uzerindeki dahili ICM-20948 IMU'yu SPI (/dev/spidev0.3) uzerinden
    okuyup sensor_msgs/Imu olarak yayinlayan surucu node'u.
  </description>
  <maintainer email="gemstone@todo.todo">gemstone</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_updater</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
