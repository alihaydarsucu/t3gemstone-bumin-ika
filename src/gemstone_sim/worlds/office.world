<?xml version="1.0"?>
<!--
  Gemstone UGV simülasyon dünyası: 12x12 m kapalı ofis.

  Düzen (üstten):
  - Dış duvarlar: +-6 m
  - İç bölme duvarları (L plan) robotun görüş alanını kırar
  - Masalar, kitaplıklar, orta sehpa (engel + sensör hedefi)
  - Sütunlar (silindir), kasalar (kutu), bitki (silindir + küre)
  - Robot (0, 0) civarında açık bölgede başlar; orta koridor boş tutulur
-->
<sdf version="1.7">
  <world name="gemstone_office">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.72 0.78 0.82 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- ==================== Dış duvarlar ==================== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 3.0</size></box></geometry>
          <material>
            <ambient>0.75 0.76 0.78 1.0</ambient>
            <diffuse>0.75 0.76 0.78 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.4 0.2 3.0</size></box></geometry>
          <material>
            <ambient>0.75 0.76 0.78 1.0</ambient>
            <diffuse>0.75 0.76 0.78 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.4 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 3.0</size></box></geometry>
          <material>
            <ambient>0.75 0.76 0.78 1.0</ambient>
            <diffuse>0.75 0.76 0.78 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 12.4 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 3.0</size></box></geometry>
          <material>
            <ambient>0.75 0.76 0.78 1.0</ambient>
            <diffuse>0.75 0.76 0.78 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== İç bölme duvarları ==================== -->
    <model name="partition_1">
      <static>true</static>
      <pose>-1.5 -2.2 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.1 2.0</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1.0</ambient>
            <diffuse>0.55 0.58 0.62 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="partition_2">
      <static>true</static>
      <pose>1.0 1.5 1.0 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.5 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.5 0.1 2.0</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1.0</ambient>
            <diffuse>0.55 0.58 0.62 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Sütunlar ==================== -->
    <model name="column_1">
      <static>true</static>
      <pose>-4.0 1.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>3.0</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.72 1.0</ambient>
            <diffuse>0.7 0.7 0.72 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="column_2">
      <static>true</static>
      <pose>4.0 -2.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>3.0</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.72 1.0</ambient>
            <diffuse>0.7 0.7 0.72 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="column_3">
      <static>true</static>
      <pose>-3.5 3.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>3.0</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.72 1.0</ambient>
            <diffuse>0.7 0.7 0.72 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Masalar ==================== -->
    <model name="desk_1">
      <static>true</static>
      <pose>-2.6 3.2 0.4 0 0 0.15</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
          <material>
            <ambient>0.5 0.38 0.25 1.0</ambient>
            <diffuse>0.5 0.38 0.25 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="desk_2">
      <static>true</static>
      <pose>2.8 3.2 0.4 0 0 -0.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
          <material>
            <ambient>0.5 0.38 0.25 1.0</ambient>
            <diffuse>0.5 0.38 0.25 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="desk_3">
      <static>true</static>
      <pose>-2.9 -4.3 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.3 0.65 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.3 0.65 0.8</size></box></geometry>
          <material>
            <ambient>0.5 0.38 0.25 1.0</ambient>
            <diffuse>0.5 0.38 0.25 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Kitaplıklar ==================== -->
    <model name="bookshelf_1">
      <static>true</static>
      <pose>-3.6 -1.2 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.3 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.3 1.8</size></box></geometry>
          <material>
            <ambient>0.35 0.3 0.25 1.0</ambient>
            <diffuse>0.35 0.3 0.25 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="bookshelf_2">
      <static>true</static>
      <pose>3.7 0.8 0.9 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.3 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.3 1.8</size></box></geometry>
          <material>
            <ambient>0.35 0.3 0.25 1.0</ambient>
            <diffuse>0.35 0.3 0.25 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Orta sehpa ==================== -->
    <model name="coffee_table">
      <static>true</static>
      <pose>2.2 -3.4 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.1 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.1 0.6 0.6</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.46 1.0</ambient>
            <diffuse>0.4 0.42 0.46 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Kasalar / kutular (engel) ==================== -->
    <model name="crate_1">
      <static>true</static>
      <pose>0.9 -0.6 0.25 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.72 0.55 0.18 1.0</ambient>
            <diffuse>0.72 0.55 0.18 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_2">
      <static>true</static>
      <pose>0.35 -1.55 0.15 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.6 0.5 0.2 1.0</ambient>
            <diffuse>0.6 0.5 0.2 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_3">
      <static>true</static>
      <pose>-0.9 2.9 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.72 0.55 0.18 1.0</ambient>
            <diffuse>0.72 0.55 0.18 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="crate_4">
      <static>true</static>
      <pose>1.3 3.6 0.15 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.6 0.5 0.2 1.0</ambient>
            <diffuse>0.6 0.5 0.2 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== Bitkiler (saksı + yeşillik) ==================== -->
    <model name="plant_1">
      <static>true</static>
      <pose>-2.2 -4.8 0 0 0 0</pose>
      <link name="pot">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.35 0.2 1.0</ambient>
            <diffuse>0.55 0.35 0.2 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 0.55 0 0 0</pose>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>0.2 0.5 0.25 1.0</ambient>
            <diffuse>0.2 0.5 0.25 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
      <joint name="pot_foliage" type="fixed">
        <parent>pot</parent>
        <child>foliage</child>
      </joint>
    </model>

    <model name="plant_2">
      <static>true</static>
      <pose>4.5 4.2 0 0 0 0</pose>
      <link name="pot">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.55 0.35 0.2 1.0</ambient>
            <diffuse>0.55 0.35 0.2 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 0.55 0 0 0</pose>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material>
            <ambient>0.2 0.5 0.25 1.0</ambient>
            <diffuse>0.2 0.5 0.25 1.0</diffuse>
            <specular>0.05 0.05 0.05 1.0</specular>
          </material>
        </visual>
      </link>
      <joint name="pot_foliage" type="fixed">
        <parent>pot</parent>
        <child>foliage</child>
      </joint>
    </model>

    <!-- ==================== Sandalyeler ==================== -->
    <model name="chair_1">
      <static>true</static>
      <pose>-2.1 3.8 0.22 0 0 0.15</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.45 0.44</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.44</size></box></geometry>
          <material>
            <ambient>0.25 0.28 0.33 1.0</ambient>
            <diffuse>0.25 0.28 0.33 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
      </link>
