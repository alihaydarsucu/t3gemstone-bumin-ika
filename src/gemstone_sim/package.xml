<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gemstone_sim</name>
  <version>0.1.0</version>
  <description>
    Gazebo Classic simülasyon paketi: gemstone UGV için özel ofis dünyası,
    gazebo eklentili robot URDF'i ve gemstone üst katman node'larını tek bir
    launch'ta toplar. Donanım node'ları simülasyonda çalışmaz; onların yerini
    gazebo_ros plugin'leri alır.
  </description>
  <maintainer email="gemstone@todo.todo">gemstone</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gemstone_motor_driver</exec_depend>
  <exec_depend>gemstone_exploration_demo</exec_depend>
  <exec_depend>gemstone_obstacle_avoidance</exec_depend>
  <exec_depend>gemstone_image_proc</exec_depend>
  <!-- rviz default config'i gemstone_frontier_explorer paketinden gelir
       (sim_bringup.launch.py rviz_config_file default'u). -->
  <exec_depend>gemstone_frontier_explorer</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
