<?xml version="1.0"?>
<robot name="gemstone_ugv_gazebo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gemstone UGV'nin Gazebo Classic simülasyonuna uygun 3 katli hali.
    Gerçek robot URDF'i (gemstone_bringup/urdf/gemstone_ugv.urdf.xacro) ile
    aynı kinematik yapı (2 tahrik tekeri + 1 ön misket teker) kullanılır.

    3 katli mekanik yapi (asagidan yukari):
      - ALT KAT   : şasi tablasi + iki yanda encoder'li tahrik tekerleri +
                    ortada 3S LiPo pil
      - ORTA KAT  : gemstone (O1) karti + motor surucu (platformun uzerinde)
      - UST KAT   : A1M8 lidar (platform uzerinde, en tepede)

    ONEMLI: Her katmanın yerlesimi JOINT origin'inde tasinir; boylece her
    linkin FRAME'i kendi katinda durur. Sensörler (<gazebo reference> ile
    eklenen ray/imu/camera) linkin FRAME orijininden yayilir - eger joint
    origin'i tasimazsaniz sensörler base_link orijininde (en altta) kalir.

    Farklar:
      - Ölçüler fizik/denge için hafif düzeltildi. Tekerler şasinin altından
        taşar ve robot yerde dengede durur (3 nokta: 2 teker + 1 misket).
      - gazebo_ros plugin'leri eklendi:
          * diff_drive        -> /cmd_vel dinler, /odom + odom->base_link TF yayinlar
          * gpu/cpu ray lidar -> /scan (360 ornek, 3.5 m, RPLidar A1M8 benzeri)
          * imu_sensor        -> /imu/data (gemstone kartinin uzerinde)
          * camera            -> /camera/image_raw (lidar duzleminin altinda)
          * joint_state       -> /joint_states (robot_state_publisher icin)
      - Tekerlekler yere tutunmasi icin yuksek surtunme (mu=100000) tanimli.
  -->

  <!-- ======================= Yer tutucu olculer (sim) ======================= -->
  <!-- Alt kapi (base_link) tablasi -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width" value="0.20"/>
  <xacro:property name="chassis_thickness" value="0.03"/>
  <xacro:property name="chassis_mass" value="1.0"/>

  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.10"/>
  <xacro:property name="wheel_separation" value="0.30"/>
  <xacro:property name="wheel_x_offset" value="-0.05"/>
  <!-- Teker aksinin base_link merkezine gore Z yuksekligi:
       aks yerde duracak sekilde ayarlanir. Robot spawn z=0.075 ile yerle bulusur. -->
  <xacro:property name="wheel_axle_z" value="-0.01"/>

  <xacro:property name="caster_radius" value="0.02"/>
  <xacro:property name="caster_x_offset" value="0.12"/>
  <xacro:property name="caster_z_offset" value="-0.055"/>

  <!-- 3S LiPo pil (alt katin ortasinda) -->
  <xacro:property name="battery_length" value="0.14"/>
  <xacro:property name="battery_width" value="0.09"/>
  <xacro:property name="battery_height" value="0.025"/>
  <xacro:property name="battery_z" value="${chassis_thickness/2 + battery_height/2}"/>
  <xacro:property name="battery_mass" value="0.25"/>

  <!-- Orta kapi tablasi (gemstone + motor surucu) -->
  <xacro:property name="mid_plate_length" value="0.28"/>
  <xacro:property name="mid_plate_width" value="0.18"/>
  <xacro:property name="mid_plate_thickness" value="0.03"/>
  <xacro:property name="mid_plate_z" value="${chassis_thickness/2 + 0.04 + mid_plate_thickness/2}"/>
  <xacro:property name="mid_plate_mass" value="0.8"/>

  <!-- Gemstone O1 karti ve motor surucu (orta katin uzerinde) -->
  <xacro:property name="board_length" value="0.08"/>
  <xacro:property name="board_width" value="0.06"/>
  <xacro:property name="board_thickness" value="0.015"/>
  <xacro:property name="board_z" value="${mid_plate_z + mid_plate_thickness/2 + board_thickness/2}"/>
  <xacro:property name="board_mass" value="0.05"/>

  <xacro:property name="driver_length" value="0.05"/>
  <xacro:property name="driver_width" value="0.04"/>
  <xacro:property name="driver_thickness" value="0.015"/>
  <xacro:property name="driver_x" value="0.055"/>
  <xacro:property name="driver_z" value="${board_z}"/>
  <xacro:property name="driver_mass" value="0.05"/>

  <!-- Ust kapi tablasi (A1M8 lidar) -->
  <xacro:property name="top_plate_length" value="0.22"/>
  <xacro:property name="top_plate_width" value="0.16"/>
  <xacro:property name="top_plate_thickness" value="0.02"/>
  <xacro:property name="top_plate_z" value="${board_z + board_thickness/2 + 0.02 + top_plate_thickness/2}"/>
  <xacro:property name="top_plate_mass" value="0.6"/>

  <!-- A1M8 lidar (ust katin uzerinde, en tepede) -->
  <xacro:property name="lidar_radius" value="0.026"/>
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_z" value="${top_plate_z + top_plate_thickness/2 + lidar_height/2}"/>
  <xacro:property name="lidar_mass" value="0.10"/>

  <!-- Kamera: ust katin on kenarinda, lidar duzleminin ALTINDA kalsin ki
       lidar ışınlarını engellemesin (lidar duzlemi z=lidar_z civarinda) -->
  <xacro:property name="camera_x" value="${top_plate_length/2 + 0.015}"/>
  <xacro:property name="camera_z" value="${top_plate_z - 0.01}"/>

  <material name="gemstone_gray">
    <color rgba="0.45 0.48 0.5 1.0"/>
  </material>
  <material name="gemstone_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="gemstone_white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="battery_red">
    <color rgba="0.55 0.08 0.08 1.0"/>
  </material>
  <material name="pcb_green">
    <color rgba="0.1 0.55 0.2 1.0"/>
  </material>
  <material name="driver_blue">
    <color rgba="0.1 0.3 0.7 1.0"/>
  </material>

  <!-- ================= ALT KAT: Şasi tablasi (base_link) ================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_thickness}"/>
      </geometry>
      <material name="gemstone_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.0034" ixy="0.0" ixz="0.0" iyy="0.0076" iyz="0.0" izz="0.0108"/>
    </inertial>
  </link>

  <!-- 3S LiPo pil: alt katin ortasinda -->
  <link name="battery_link">
    <visual>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
      <material name="battery_red"/>
    </visual>
    <collision>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${battery_mass}"/>
      <inertia ixx="0.00018" ixy="0.0" ixz="0.0" iyy="0.00042" iyz="0.0" izz="0.00058"/>
    </inertial>
  </link>

  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0 0 ${battery_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ALT KAT: Tahrik tekerleri ===================== -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="gemstone_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
              <fdir1>0 0 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0002"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${y_reflect * wheel_separation / 2.0} ${wheel_axle_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <!-- ===================== ALT KAT: Misket (caster) teker ===================== -->
  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="gemstone_white"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${caster_x_offset} 0 ${caster_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ORTA KAT: platform tablasi ===================== -->
  <link name="mid_plate_link">
    <visual>
      <geometry>
        <box size="${mid_plate_length} ${mid_plate_width} ${mid_plate_thickness}"/>
      </geometry>
      <material name="gemstone_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="${mid_plate_length} ${mid_plate_width} ${mid_plate_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mid_plate_mass}"/>
      <inertia ixx="0.00222" ixy="0.0" ixz="0.0" iyy="0.00529" iyz="0.0" izz="0.00739"/>
    </inertial>
  </link>

  <joint name="mid_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid_plate_link"/>
    <origin xyz="0 0 ${mid_plate_z}" rpy="0 0 0"/>
  </joint>

  <!-- Gemstone O1 karti: orta katin uzerinde -->
  <link name="gemstone_link">
    <visual>
      <geometry>
        <box size="${board_length} ${board_width} ${board_thickness}"/>
      </geometry>
      <material name="pcb_green"/>
    </visual>
    <collision>
      <geometry>
        <box size="${board_length} ${board_width} ${board_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${board_mass}"/>
      <inertia ixx="0.000016" ixy="0.0" ixz="0.0" iyy="0.000028" iyz="0.0" izz="0.000042"/>
    </inertial>
  </link>

  <joint name="gemstone_joint" type="fixed">
    <parent link="mid_plate_link"/>
    <child link="gemstone_link"/>
    <origin xyz="0 0 ${board_z}" rpy="0 0 0"/>
  </joint>

  <!-- Motor surucu: gemstone kartinin yaninda -->
  <link name="motor_driver_link">
    <visual>
      <geometry>
        <box size="${driver_length} ${driver_width} ${driver_thickness}"/>
      </geometry>
      <material name="driver_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${driver_length} ${driver_width} ${driver_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${driver_mass}"/>
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000012" iyz="0.0" izz="0.000018"/>
    </inertial>
  </link>

  <joint name="motor_driver_joint" type="fixed">
    <parent link="mid_plate_link"/>
    <child link="motor_driver_link"/>
    <origin xyz="${driver_x} 0 ${driver_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== UST KAT: platform tablasi ===================== -->
  <link name="top_plate_link">
    <visual>
      <geometry>
        <box size="${top_plate_length} ${top_plate_width} ${top_plate_thickness}"/>
      </geometry>
      <material name="gemstone_gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="${top_plate_length} ${top_plate_width} ${top_plate_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${top_plate_mass}"/>
      <inertia ixx="0.00130" ixy="0.0" ixz="0.0" iyy="0.00244" iyz="0.0" izz="0.00370"/>
    </inertial>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="mid_plate_link"/>
    <child link="top_plate_link"/>
    <origin xyz="0 0 ${top_plate_z}" rpy="0 0 0"/>
  </joint>

  <!-- A1M8 lidar: ust katin uzerinde, en tepede -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="gemstone_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <inertia ixx="0.000025" ixy="0.0" ixz="0.0" iyy="0.000025" iyz="0.0" izz="0.000034"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Kamera (ust kat, onde) ===================== -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.02 0.02"/>
      </geometry>
      <material name="gemstone_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0000013" ixy="0.0" ixz="0.0" iyy="0.0000013" iyz="0.0" izz="0.0000022"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== IMU (gemstone karti uzerinde) ===================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="gemstone_white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${board_z + board_thickness/2 + 0.005}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ Sensörler ============================ -->
  <!-- NOT: Gazebo Classic <sensor> etiketini URDF <link> icinden okumaz;
       sensorler mutlaka <gazebo reference="..."> blogunda olmali. -->

  <!-- IMU: /imu/data -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 2D Lidar: /scan (RPLidar A1M8 benzeri, 360 ornek, 3.5 m) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28318</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_scan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Kamera: /camera/image_raw -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="camera" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=image_raw</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================ Gazebo plugin'leri ============================ -->

  <!-- Diferansiyel sürüş: /cmd_vel dinler, /odom + odom->base_link TF yayinlar -->
  <gazebo>
    <plugin name="gemstone_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>10</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Tekerlek joint'lerini /joint_states'e yayinlar (robot_state_publisher icin) -->
  <gazebo>
    <plugin name="gemstone_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Gölgelendirme iyileştirmesi (isteğe bağlı görsel) -->
  <gazebo reference="base_link">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

</robot>
