<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gemstone_bringup</name>
  <version>0.1.0</version>
  <description>
    Aracin tum surucu node'larini (IMU, motor, kamera, lidar) tek bir master
    launch dosyasinda toplayan, robot_state_publisher icin URDF ve ortak
    parametreleri barindiran ust duzey paket.
  </description>
  <maintainer email="gemstone@todo.todo">gemstone</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gemstone_imu</exec_depend>
  <exec_depend>gemstone_motor_driver</exec_depend>
  <exec_depend>gemstone_ultrasonic</exec_depend>
  <exec_depend>gemstone_camera</exec_depend>
  <exec_depend>gemstone_image_proc</exec_depend>
  <exec_depend>gemstone_lidar_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
